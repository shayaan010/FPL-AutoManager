DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fpl_automanager
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_ORIGIN=http://localhost:5173
# Required in production: encrypts stored FPL tokens and must stay stable
APP_SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
# Local only: opens a real browser on the server machine for FPL sign-in
ENABLE_BROWSER_LOGIN=true
